  "tokenColors": [
    {
      "name": "Texto base",
      "scope": ["source", "text"],
      "settings": { "foreground": "#ede9e0" }
    },
    {
      "name": "Comentários",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8c877e", "fontStyle": "italic" }
    },
    {
      "name": "Pontuação",
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#b9b2a2" }
    },
    {
      "name": "Palavras-chave",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.delete",
        "keyword.operator.logical.python",
        "storage",
        "storage.type",
        "storage.modifier",
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": { "foreground": "#f6506d" }
    },
    {
      "name": "Operadores",
      "scope": ["keyword.operator", "punctuation.separator.key-value", "punctuation.accessor"],
      "settings": { "foreground": "#c9c2b3" }
    },
    {
      "name": "Textos",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#86efac" }
    },
    {
      "name": "Escapes e expressões regulares",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.character-class.regexp"],
      "settings": { "foreground": "#fbbf24" }
    },
    {
      "name": "Números e constantes",
      "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant", "keyword.other.unit"],
      "settings": { "foreground": "#fbbf24" }
    },
    {
      "name": "Funções",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": { "foreground": "#8ecdf5" }
    },
    {
      "name": "Tipos e classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "meta.return.type"
      ],
      "settings": { "foreground": "#f3d9a4" }
    },
    {
      "name": "Propriedades",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "support.variable.property"
      ],
      "settings": { "foreground": "#d9d3c4" }
    },
    {
      "name": "Variáveis",
      "scope": ["variable", "variable.other.readwrite", "variable.parameter", "meta.definition.variable"],
      "settings": { "foreground": "#ede9e0" }
    },
    {
      "name": "this e super",
      "scope": ["variable.language", "variable.language.this", "variable.language.super"],
      "settings": { "foreground": "#f6506d", "fontStyle": "italic" }
    },
    {
      "name": "Atributos HTML",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#f3d9a4", "fontStyle": "italic" }
    },
    {
      "name": "Classes e ids de CSS",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.name.tag.css"],
      "settings": { "foreground": "#f3d9a4" }
    },
    {
      "name": "Propriedades de CSS",
      "scope": ["support.type.property-name.css", "meta.property-name.css"],
      "settings": { "foreground": "#d9d3c4" }
    },
    {
      "name": "Variáveis de CSS",
      "scope": ["variable.css", "support.type.custom-property.name", "variable.argument.css"],
      "settings": { "foreground": "#8ecdf5" }
    },
    {
      "name": "Chaves de JSON e YAML",
      "scope": ["support.type.property-name.json", "entity.name.tag.yaml"],
      "settings": { "foreground": "#8ecdf5" }
    },
    {
      "name": "Decoradores",
      "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#fbbf24" }
    },
    {
      "name": "Markdown: títulos",
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#f6506d", "fontStyle": "bold" }
    },
    {
      "name": "Markdown: ênfase",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#f3d9a4", "fontStyle": "italic" }
    },
    {
      "name": "Markdown: negrito",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown: código",
      "scope": ["markup.inline.raw", "markup.fenced_code.block.markdown", "markup.raw"],
      "settings": { "foreground": "#86efac" }
    },
    {
      "name": "Links",
      "scope": ["markup.underline.link", "string.other.link", "meta.link"],
      "settings": { "foreground": "#8ecdf5" }
    },
    {
      "name": "Markdown: citações e listas",
      "scope": ["markup.quote", "punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list.markdown"],
      "settings": { "foreground": "#fbbf24" }
    },
    {
      "name": "Diff: inserido",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#86efac" }
    },
    {
      "name": "Diff: removido",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#f87171" }
    },
    {
      "name": "Diff: alterado",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#fbbf24" }
    },
    {
      "name": "Inválido",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff7a90", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#f3d9a4",
    "type": "#f3d9a4",
    "class": "#f3d9a4",
    "enum": "#f3d9a4",
    "interface": "#f3d9a4",
    "struct": "#f3d9a4",
    "typeParameter": "#f3d9a4",
    "function": "#8ecdf5",
    "method": "#8ecdf5",
    "decorator": "#fbbf24",
    "macro": "#fbbf24",
    "property": "#d9d3c4",
    "enumMember": "#fbbf24",
    "variable": "#ede9e0",
    "variable.readonly": "#fbbf24",
    "parameter": { "foreground": "#ede9e0", "italic": true },
    "keyword": "#f6506d",
    "comment": { "foreground": "#8c877e", "italic": true }
  }
}
